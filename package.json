{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "phase-001": "echo \"Phase 001 already completed\"",
    "phase-002": "echo \"Phase 002 already completed\"",
    "phase-003": "echo \"Phase 003 already completed\"",
    "phase-004": "echo \"Phase 004 already completed\"",
    "phase-005": "node scripts/runPhase.js 005",
    "phase-006": "echo \"Phase 006 is planning only\"",
    "phase-007": "node scripts/runPhase.js 007",
    "phase-008": "cd backend && ./gradlew build",
    "phase-009": "npm run test:e2e",
    "phase-010": "npm run build && npm run lint",
    "phase-011": "npm run docker:build && npm run ci:deploy"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
